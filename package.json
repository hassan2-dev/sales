{
  "name": "energy-horizon",
  "version": "1.0.0",
  "private": true,
  "description": "Energy Horizon / Afaq Al-Taqa — Oil & Gas digital platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @energy-horizon/api",
    "dev:website": "npm run dev -w @energy-horizon/website",
    "dev:store": "npm run dev -w @energy-horizon/store",
    "dev:admin": "npm run dev -w @energy-horizon/admin",
    "dev:web": "npm run dev:website",
    "build:api": "npm run build -w @energy-horizon/api",
    "build:website": "npm run build -w @energy-horizon/website",
    "build:store": "npm run build -w @energy-horizon/store",
    "build:admin": "npm run build -w @energy-horizon/admin",
    "build": "npm run build:api && npm run build:website && npm run build:store && npm run build:admin",
    "db:generate": "npm run prisma:generate -w @energy-horizon/api",
    "db:migrate": "npm run prisma:migrate -w @energy-horizon/api",
    "db:seed": "npm run prisma:seed -w @energy-horizon/api",
    "db:studio": "npm run prisma:studio -w @energy-horizon/api"
  },
  "engines": {
    "node": ">=20"
  }
}
