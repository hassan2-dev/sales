DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energy_horizon?schema=public
PORT=3000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173,http://store.localhost:5173,http://admin.localhost:5173
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
APP_URL=http://localhost:3000
UPLOAD_MAX_SIZE_MB=10

# Cloudflare R2 (preferred). Leave empty → local ./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=energy-horizon
R2_PUBLIC_URL=
R2_REGION=auto

# Optional S3/MinIO fallback if R2_ACCOUNT_ID is empty
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
