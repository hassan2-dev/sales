# Energy Horizon Platform

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energy_horizon?schema=public

# API
PORT=3000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Storage — Cloudflare R2 (preferred). Leave empty to use local ./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=energy-horizon
R2_PUBLIC_URL=
R2_REGION=auto

# Optional fallback: generic S3 / MinIO (used only if R2_ACCOUNT_ID is empty)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
UPLOAD_MAX_SIZE_MB=10

# App
APP_NAME=Energy Horizon
APP_URL=http://localhost:5173
